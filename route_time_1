from ortools.constraint_solver import routing_enums_pb2
from ortools.constraint_solver import pywrapcp


def create_data_model():
    """存储项目的数据模型"""
    data = {}

    # 地点列表说明：
    # Index 0: 发货起点 (Depot / 餐厅 / 仓库)
    # Index 1 ~ 4: 4 个顾客送货点
    data["locations"] = [
        "起点 (餐厅/仓库)",
        "顾客 A",
        "顾客 B",
        "顾客 C",
        "顾客 D",
    ]

    # 时间矩阵 (单位：分钟)
    # time_matrix[i][j] 表示从地点 i 到地点 j 所需的行驶时间
    data["time_matrix"] = [
        [0, 10, 15, 20, 25],  # 从起点出发到各点的时间
        [10, 0, 35, 25, 30],  # 从顾客 A 到各点的时间
        [15, 35, 0, 30, 20],  # 从顾客 B 到各点的时间
        [20, 25, 30, 0, 15],  # 从顾客 C 到各点的时间
        [25, 30, 20, 15, 0],  # 从顾客 D 到各点的时间
    ]

    # 每个送货点的服务/交付耗时（比如卸货、找人、交接菜品的时间，单位：分钟）
    data["service_times"] = [0, 5, 5, 5, 5]  # 起点为0，每个顾客点停留5分钟

    data["num_vehicles"] = 1  # 当前安排 1 位司机
    data["depot"] = 0  # 出发起点索引 (Index 0)

    return data


def main():
    # 1. 初始化数据
    data = create_data_model()

    # 2. 创建路径规划模型索引管理器 (地点数, 车辆数, 起点)
    manager = pywrapcp.RoutingIndexManager(
        len(data["time_matrix"]), data["num_vehicles"], data["depot"]
    )

    # 3. 创建 Routing Model
    routing = pywrapcp.RoutingModel(manager)

    # 4. 定义回调函数：计算从 node_A 到 node_B 的“总耗时”（行驶时间 + 目的地服务时间）
    def time_callback(from_index, to_index):
        from_node = manager.IndexToNode(from_index)
        to_node = manager.IndexToNode(to_index)
        travel_time = data["time_matrix"][from_node][to_node]
        service_time = data["service_times"][to_node]
        return travel_time + service_time

    transit_callback_index = routing.RegisterTransitCallback(time_callback)

    # 5. 设置优化目标：以“最小化总耗时”为目标
    routing.SetArcCostEvaluatorOfAllVehicles(transit_callback_index)

    # 6. 设置求解参数
    search_parameters = pywrapcp.DefaultRoutingSearchParameters()
    search_parameters.first_solution_strategy = (
        routing_enums_pb2.FirstSolutionStrategy.PATH_CHEAPEST_ARC
    )

    # 7. 求解
    solution = routing.SolveWithParameters(search_parameters)

    # 8. 输出结果
    if solution:
        print_solution(manager, routing, solution, data)
    else:
        print("未找到有效路径！")


def print_solution(manager, routing, solution, data):
    """打印最终优化的送货路线"""
    print("=" * 45)
    print(" 🚀 最短时间送货路线规划完成")
    print("=" * 45)

    index = routing.Start(0)
    plan_output = "最佳送货顺序：\n"
    total_time = 0

    while not routing.IsEnd(index):
        node = manager.IndexToNode(index)
        location_name = data["locations"][node]
        plan_output += f" 📍 {location_name} ->"

        previous_index = index
        index = solution.Value(routing.NextVar(index))

        # 累加这一段的行车时间 + 服务时间
        from_node = manager.IndexToNode(previous_index)
        to_node = manager.IndexToNode(index)
        segment_time = (
            data["time_matrix"][from_node][to_node]
            + data["service_times"][to_node]
        )
        total_time += segment_time

    # 最后一个点
    end_node = manager.IndexToNode(index)
    plan_output += f" 📍 {data['locations'][end_node]}"

    print(plan_output)
    print("-" * 45)
    print(f"⏱️ 全程预估总耗时（含行驶与卸货）: {total_time} 分钟")
    print("=" * 45)


if __name__ == "__main__":
    main()